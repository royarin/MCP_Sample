<!--
  Demo 4 · Security – apply at the scope of the opsdesk-secure MCP server.
  Validates an Entra ID access token issued for the MCP resource app (api://opsdesk-mcp) and requires
  one of the app roles. Named values: {{tenant-id}}, {{opsdesk-mcp-app-id}}.
-->
<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401"
                  failed-validation-error-message="A valid Entra ID access token for api://opsdesk-mcp is required."
                  require-scheme="Bearer" output-token-variable-name="jwt">
      <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>api://opsdesk-mcp</audience>
        <audience>{{opsdesk-mcp-app-id}}</audience>
      </audiences>
      <required-claims>
        <claim name="roles" match="any">
          <value>Ops.Reader</value>
          <value>Ops.Operator</value>
        </claim>
      </required-claims>
    </validate-jwt>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
