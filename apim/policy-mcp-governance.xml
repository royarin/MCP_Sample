<!--
  Demo 4 · Governance – same scope as policy-mcp-auth.xml, placed AFTER validate-jwt (it reads the jwt variable).
    1. Rate limit per calling identity.
    2. Tool-level allow-listing: tools/call for a write tool is only permitted with role Ops.Operator.
       Everyone else gets a JSON-RPC result with isError=true and a message the model relays
       ("escalate to an operator"). Works on the JSON-RPC envelope MCP sends over Streamable HTTP.
  If your APIM version exposes MCP-specific policy constructs, prefer those; this version is generic.
-->
<policies>
  <inbound>
    <base />
    <rate-limit-by-key calls="30" renewal-period="60"
        counter-key="@{
            var jwt = context.Variables.ContainsKey("jwt") ? (Jwt)context.Variables["jwt"] : null;
            string azp = null; if (jwt != null) { string[] v; if (jwt.Claims.TryGetValue("azp", out v) || jwt.Claims.TryGetValue("appid", out v) || jwt.Claims.TryGetValue("oid", out v)) azp = v[0]; }
            return azp ?? context.Request.IpAddress;
        }" />

    <set-variable name="rpcBody" value="@{
        try { return context.Request.Body.As<JObject>(preserveContent: true); } catch { return null; }
    }" />
    <set-variable name="isWriteCall" value="@{
        var body = (JObject)context.Variables["rpcBody"];
        if (body == null) return false;
        var method = (string)body["method"];
        var tool = ((string)body.SelectToken("params.name")) ?? "";
        var writeTools = new [] { "CreateIncident", "NotifyIncident", "UpdateSystemStatus", "raise_incident", "update_system_status" };
        return method == "tools/call" && writeTools.Contains(tool);
    }" />
    <set-variable name="isOperator" value="@{
        var jwt = context.Variables.ContainsKey("jwt") ? (Jwt)context.Variables["jwt"] : null;
        if (jwt == null) return false;
        string[] roles;
        return jwt.Claims.TryGetValue("roles", out roles) && roles.Contains("Ops.Operator");
    }" />
    <choose>
      <when condition="@((bool)context.Variables["isWriteCall"] && !(bool)context.Variables["isOperator"])">
        <return-response>
          <set-status code="200" reason="OK" />
          <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
          <set-body>@{
            var body = (JObject)context.Variables["rpcBody"];
            var tool = (string)body.SelectToken("params.name");
            var result = new JObject(
              new JProperty("jsonrpc", "2.0"),
              new JProperty("id", body["id"]),
              new JProperty("result", new JObject(
                new JProperty("isError", true),
                new JProperty("content", new JArray(new JObject(
                  new JProperty("type", "text"),
                  new JProperty("text", "Policy: " + tool + " requires the Ops.Operator role. This agent only has read access – ask an operator to perform the action.")))))));
            return result.ToString();
          }</set-body>
        </return-response>
      </when>
    </choose>
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
