{
  "servers": {
    "opsdesk-code": {
      "type": "http",
      "url": "https://${input:apimName}.azure-api.net/opsdesk-code/mcp",
      "headers": {
        "Ocp-Apim-Subscription-Key": "${input:apimKey}"
      }
    },
    "opsdesk-apim": {
      "type": "http",
      "url": "https://${input:apimName}.azure-api.net/opsdesk-apim/mcp",
      "headers": {
        "Ocp-Apim-Subscription-Key": "${input:apimKey}"
      }
    }
  },
  "inputs": [
    {
      "id": "apimName",
      "type": "promptString",
      "description": "APIM service name (without https:// or .azure-api.net)"
    },
    {
      "id": "apimKey",
      "type": "promptString",
      "password": true,
      "description": "APIM subscription key for product demo-open"
    }
  ]
}
