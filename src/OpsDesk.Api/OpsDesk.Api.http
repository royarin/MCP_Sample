@OpsDesk.Api_HostAddress = http://localhost:5047

# ── Database ──────────────────────────────────────────────────

### Reset database to original seeded state (Development only)
POST {{OpsDesk.Api_HostAddress}}/database/reset

###

# ── SystemStatus ─────────────────────────────────────────────

### List all system statuses
GET {{OpsDesk.Api_HostAddress}}/systemstatus
Accept: application/json

###

### List only red systems
GET {{OpsDesk.Api_HostAddress}}/systemstatus?status=red
Accept: application/json

###

### List only yellow systems
GET {{OpsDesk.Api_HostAddress}}/systemstatus?status=yellow
Accept: application/json

###

### Get status - payments (green)
GET {{OpsDesk.Api_HostAddress}}/systemstatus/payments
Accept: application/json

###

### Get status - auth (yellow)
GET {{OpsDesk.Api_HostAddress}}/systemstatus/auth
Accept: application/json

###

### Get status - notifications (green)
GET {{OpsDesk.Api_HostAddress}}/systemstatus/notifications
Accept: application/json

###

### Get status - inventory (red)
GET {{OpsDesk.Api_HostAddress}}/systemstatus/inventory
Accept: application/json

###

### Get status - reporting (green)
GET {{OpsDesk.Api_HostAddress}}/systemstatus/reporting
Accept: application/json

###

### Get status - unknown system (404)
GET {{OpsDesk.Api_HostAddress}}/systemstatus/unknown
Accept: application/json

###

### Update status - resolve inventory incident
POST {{OpsDesk.Api_HostAddress}}/systemstatus/inventory
Content-Type: application/json

{
  "status": "green",
  "message": "Database replication lag resolved. All replicas in sync."
}

###

### Update status - bad status value (400)
POST {{OpsDesk.Api_HostAddress}}/systemstatus/payments
Content-Type: application/json

{
  "status": "purple",
  "message": "Invalid status test"
}

###

