{
  "//": "Copy to .vscode/mcp.json. Replace <apim-name> with your deployed APIM service name. Enable one server at a time during the demo.",
  "servers": {
    "opsdesk-code":   { "type": "http", "url": "https://<apim-name>.azure-api.net/opsdesk-code/mcp",
                        "headers": { "Ocp-Apim-Subscription-Key": "${input:apimKey}" } },
    "opsdesk-tasks":  { "type": "http", "url": "https://<apim-name>.azure-api.net/opsdesk-tasks/mcp",
                        "headers": { "Ocp-Apim-Subscription-Key": "${input:apimKey}" } },
    "opsdesk-apim":   { "type": "http", "url": "https://<apim-name>.azure-api.net/opsdesk-apim/mcp",
                        "headers": { "Ocp-Apim-Subscription-Key": "${input:apimKey}" } },
    "opsdesk-apim-secure": { "type": "http", "url": "https://<apim-name>.azure-api.net/opsdesk-apim-secure/mcp",
                        "headers": {
                          "Ocp-Apim-Subscription-Key": "${input:apimKey}",
                          "Authorization": "Bearer ${input:token}"
                        } }
  },
  "inputs": [
    { "id": "apimKey", "type": "promptString", "password": true, "description": "APIM subscription key (product demo-open)" },
    { "id": "token",   "type": "promptString", "password": true, "description": "Entra app token with Ops.Agent (prefer OpsBot.Enterprise for Demo 4)" }
  ]
}
